{
  "manifestVersion": 1,
  "id": "resource-planner",
  "version": "0.1.3",
  "name": "Resource Planner & Heatmap",
  "publisher": "amanullah-ado",
  "public": true,
  "description": "See who works on which Epic and how each person's capacity is used: a utilization heatmap, resource timeline, Epic Gantt and dashboard widgets for Azure Boards.",
  "categories": [
    "Azure Boards"
  ],
  "tags": [
    "resource planning",
    "capacity",
    "heatmap",
    "gantt",
    "utilization",
    "epic",
    "timeline"
  ],
  "targets": [
    {
      "id": "Microsoft.VisualStudio.Services"
    },
    {
      "id": "Microsoft.TeamFoundation.Server",
      "version": "[16.0,)"
    }
  ],
  "icons": {
    "default": "images/planner-icon.png"
  },
  "content": {
    "details": {
      "path": "overview.md"
    },
    "license": {
      "path": "LICENSE"
    }
  },
  "scopes": [
    "vso.work",
    "vso.project"
  ],
  "files": [
    {
      "path": "dist",
      "addressable": true,
      "packagePath": "dist"
    },
    {
      "path": "images",
      "addressable": true,
      "packagePath": "images"
    }
  ],
  "contributions": [
    {
      "id": "planner-hub",
      "type": "ms.vss-web.hub",
      "description": "Utilization heatmap, resource timeline and Epic Gantt.",
      "targets": [
        "ms.vss-work-web.work-hub-group"
      ],
      "properties": {
        "name": "Resource Planner",
        "order": 60,
        "uri": "dist/hub/index.html"
      }
    },
    {
      "id": "widget-tile",
      "type": "ms.vss-dashboards-web.widget",
      "description": "Share of available hours that is booked this month, with the number of people in each colour band.",
      "targets": [
        "ms.vss-dashboards-web.widget-catalog",
        "amanullah-ado.resource-planner.widgets-config"
      ],
      "properties": {
        "name": "Utilization (Resource Planner)",
        "description": "Share of available hours that is booked this month, with the number of people in each colour band.",
        "catalogIconUrl": "images/widget-icon.png",
        "previewImageUrl": "images/preview-tile.png",
        "uri": "dist/widgets/tile/index.html",
        "supportedSizes": [
          {
            "rowSpan": 2,
            "columnSpan": 2
          },
          {
            "rowSpan": 2,
            "columnSpan": 3
          }
        ],
        "supportedScopes": [
          "project_team"
        ]
      }
    },
    {
      "id": "widget-over",
      "type": "ms.vss-dashboards-web.widget",
      "description": "The people booked above their available hours this month, most overloaded first.",
      "targets": [
        "ms.vss-dashboards-web.widget-catalog",
        "amanullah-ado.resource-planner.widgets-config"
      ],
      "properties": {
        "name": "Over capacity (Resource Planner)",
        "description": "The people booked above their available hours this month, most overloaded first.",
        "catalogIconUrl": "images/widget-icon.png",
        "previewImageUrl": "images/preview-over.png",
        "uri": "dist/widgets/over/index.html",
        "supportedSizes": [
          {
            "rowSpan": 2,
            "columnSpan": 2
          },
          {
            "rowSpan": 3,
            "columnSpan": 2
          },
          {
            "rowSpan": 3,
            "columnSpan": 3
          }
        ],
        "supportedScopes": [
          "project_team"
        ]
      }
    },
    {
      "id": "widget-teams",
      "type": "ms.vss-dashboards-web.widget",
      "description": "Utilization per team for the next six months as a small traffic-light map.",
      "targets": [
        "ms.vss-dashboards-web.widget-catalog",
        "amanullah-ado.resource-planner.widgets-config"
      ],
      "properties": {
        "name": "Team utilization (Resource Planner)",
        "description": "Utilization per team for the next six months as a small traffic-light map.",
        "catalogIconUrl": "images/widget-icon.png",
        "previewImageUrl": "images/preview-teams.png",
        "uri": "dist/widgets/teams/index.html",
        "supportedSizes": [
          {
            "rowSpan": 2,
            "columnSpan": 4
          },
          {
            "rowSpan": 3,
            "columnSpan": 4
          }
        ],
        "supportedScopes": [
          "project_team"
        ]
      }
    },
    {
      "id": "widgets-config",
      "type": "ms.vss-dashboards-web.widget-configuration",
      "description": "Month, team and saved query for the Resource Planner widgets.",
      "targets": [
        "ms.vss-dashboards-web.widget-configuration"
      ],
      "properties": {
        "name": "Resource Planner widget configuration",
        "description": "Month, team and saved query.",
        "uri": "dist/widgets/config/index.html"
      }
    }
  ]
}
