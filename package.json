{
  "name": "workitem-grid-rules",
  "version": "2.2.2",
  "private": true,
  "description": "Azure DevOps extension: smart grid control, conditional rules engine, dependent dropdowns and visual rule builder",
  "scripts": {
    "build": "webpack --mode production",
    "build:dev": "webpack --mode development",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "package": "node scripts/package.js main",
    "package:dev": "node scripts/package.js main --dev",
    "build:planner": "webpack --config planner/webpack.config.js --mode production",
    "build:planner:dev": "webpack --config planner/webpack.config.js --mode development",
    "package:planner": "node scripts/package.js planner",
    "package:planner:dev": "node scripts/package.js planner --dev",
    "package:all": "npm run package && npm run package:planner"
  },
  "dependencies": {
    "azure-devops-extension-api": "^4.270.0",
    "azure-devops-extension-sdk": "^4.2.0",
    "react": "^17.0.2",
    "react-dom": "^17.0.2",
    "read-excel-file": "^9.3.12",
    "write-excel-file": "^4.1.1"
  },
  "devDependencies": {
    "@types/react": "^17.0.93",
    "@types/react-dom": "^17.0.26",
    "copy-webpack-plugin": "^14.0.0",
    "css-loader": "^7.1.5",
    "html-webpack-plugin": "^5.6.8",
    "jsdom": "^29.1.1",
    "style-loader": "^4.0.0",
    "tfx-cli": "^0.24.2",
    "ts-loader": "^9.6.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.3",
    "webpack": "^5.111.1",
    "webpack-cli": "^5.1.4"
  }
}
